{
  "uid": "quarry-control",
  "title": "QUARRY · Диспетчерская — контрольная смена",
  "tags": [
    "QUARRY",
    "team-120",
    "simulation"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Independent live server control runs of team-120 dispatch-core. No browser-player or production telemetry.",
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "Сценарий",
        "type": "custom",
        "query": "baseline,speed24,speed48,delay60",
        "current": {
          "text": "baseline",
          "value": "baseline"
        },
        "options": [
          {
            "text": "baseline",
            "value": "baseline",
            "selected": true
          },
          {
            "text": "speed24",
            "value": "speed24",
            "selected": false
          },
          {
            "text": "speed48",
            "value": "speed48",
            "selected": false
          },
          {
            "text": "delay60",
            "value": "delay60",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Источник данных",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Живой серверный запуск нашей модели**, не данные вкладки игрока и не MQTT/Ditto. 4 × 100 т, план 500 т, смена 300 с. [3D-диспетчерская](/dispatch.html?mode=classic)"
      }
    },
    {
      "id": 2,
      "title": "Доставлено, т",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "quarry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
